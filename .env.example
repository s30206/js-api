NODE_ENV=production
PORT=3000

POSTGRES_USER=pcshop
POSTGRES_PASSWORD=pcshop
POSTGRES_DB=pcshop
DATABASE_URL=postgres://pcshop:pcshop@db:5432/pcshop

# Required, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Admin account created by the seed script, which runs every time the api container starts.
# ADMIN_PASSWORD is required: 8+ characters, at most 72 bytes.
ADMIN_EMAIL=admin@pcshop.local
ADMIN_PASSWORD=asdqwe123
